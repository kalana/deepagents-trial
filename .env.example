# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
TAVILY_API_KEY=

# Model is configurable so you can swap without touching code.
DEEP_BRIEF_MODEL=openrouter:openai/gpt-oss-120b

# Optional: LangSmith tracing (recommended, free tier)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deepagents-trial
